generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String    @unique // clerk user id
  email         String    @unique
  name          String?
  imageUrl      String?
  industry      String?    // Combined industry-subindustry (e.g., "tech-software-development")
  industryInsight IndustryInsight? @relation(fields: [industry], references: [industry])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile fields
  bio           String?
  experience    Int?      // Years of experience
  
  // Relations
  skills        String[]  // Array of skills
  assessments   Assessment[]
  resume        Resume?
  coverLetter   CoverLetter[]
  dsaProgress   DSAProgress?
  linkedinData  LinkedInData?
}

model Assessment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  quizScore     Float     // Overall quiz score
  questions     Json[]    // Array of {question, answer, userAnswer, isCorrect}
  category      String    // "Technical", "Behavioral", etc.
  improvementTip String?  // AI-generated improvement tip
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Resume {
  id          String    @id @default(cuid())
  userId      String    @unique    // One resume per user
  user        User      @relation(fields: [userId], references: [id])
  content     String    @db.Text // Markdown content
  atsScore    Float?
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CoverLetter {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  content         String    // Markdown content
  jobDescription  String?
  companyName     String    // Name of the company applying to
  jobTitle        String    // Position applying for
  status          String    @default("draft") // draft, completed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

// Combined Industry Trends and Salary Insights
model IndustryInsight {
  id            String    @id @default(cuid())
  industry      String    @unique  // The industry this data belongs to (e.g., "tech-software-development")
  
  // Users in this industry
  users         User[]
  
  // Salary data
  salaryRanges  Json[]    // Array of { role: string, min: float, max: float, median: float, location: string? }
  
  // Industry trends
  growthRate    Float     // Industry growth rate
  demandLevel   String    // "High", "Medium", "Low"
  topSkills     String[]  // Most in-demand skills
  
  // Market conditions
  marketOutlook String    // "Positive", "Neutral", "Negative"
  keyTrends     String[]  // Array of current industry trends
  
  // Learning suggestions
  recommendedSkills String[]  // Skills recommended for the industry
  
  lastUpdated   DateTime  @default(now())
  nextUpdate    DateTime  // Scheduled update time

  @@index([industry])
}

// DSA Progress Tracking
model DSAProgress {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  
  // Overall statistics
  totalSolved     Int       @default(0)
  easyCompleted   Int       @default(0)
  mediumCompleted Int       @default(0)
  hardCompleted   Int       @default(0)
  currentStreak   Int       @default(0)
  maxStreak       Int       @default(0)
  acceptanceRate  Float     @default(0)
  
  // Performance metrics
  averageTime     Float?    // Average time per problem in minutes
  totalTimeSpent  Float     @default(0) // Total time in hours
  
  // Relations
  solvedProblems  SolvedProblem[]
  topicProgress   TopicProgress[]
  submissions     Submission[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

// Individual solved problems
model SolvedProblem {
  id              String    @id @default(cuid())
  dsaProgressId   String
  dsaProgress     DSAProgress @relation(fields: [dsaProgressId], references: [id])
  
  problemId       String    // External problem ID (e.g., LeetCode ID)
  title           String
  difficulty      String    // Easy, Medium, Hard
  category        String    // arrays, trees, dp, etc.
  timeToSolve     Float?    // Time taken in minutes
  attempts        Int       @default(1)
  
  solvedAt        DateTime  @default(now())

  @@unique([dsaProgressId, problemId])
  @@index([dsaProgressId])
}

// Topic-wise progress
model TopicProgress {
  id              String    @id @default(cuid())
  dsaProgressId   String
  dsaProgress     DSAProgress @relation(fields: [dsaProgressId], references: [id])
  
  topicId         String    // arrays, linkedlist, trees, dp, etc.
  topicName       String
  solved          Int       @default(0)
  totalProblems   Int
  accuracy        Float     @default(0)
  averageTime     Float?    // Average time for this topic
  
  lastSolved      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([dsaProgressId, topicId])
  @@index([dsaProgressId])
}

// Code submissions tracking
model Submission {
  id              String    @id @default(cuid())
  dsaProgressId   String
  dsaProgress     DSAProgress @relation(fields: [dsaProgressId], references: [id])
  
  problemId       String
  problemTitle    String
  difficulty      String
  status          String    // Accepted, Wrong Answer, Time Limit Exceeded, etc.
  language        String    // JavaScript, Python, Java, etc.
  code            String    @db.Text
  runtime         String?   // e.g., "68ms"
  memory          String?   // e.g., "44.2MB"
  
  submittedAt     DateTime  @default(now())

  @@index([dsaProgressId])
  @@index([submittedAt])
}

// LinkedIn Profile Data
model LinkedInData {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  
  // Profile information
  profileUrl      String?
  headline        String?
  summary         String?
  location        String?
  industry        String?
  connectionsCount Int      @default(0)
  
  // Analytics data
  profileViews    Json?     // Weekly and monthly views data
  searchAppearances Json?   // Search ranking and keywords
  postAnalytics   Json?     // Post engagement metrics
  
  // Optimization scores
  profileCompleteness Int   @default(0)
  optimizationScore   Int   @default(0)
  seoScore           Int   @default(0)
  
  // Tracking
  lastSynced      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}